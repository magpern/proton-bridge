# ============================================================
# Proton Mail Bridge — local Docker configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Bridge image version to build.
# Check latest: https://github.com/ProtonMail/proton-bridge/releases
BRIDGE_VERSION=3.24.2

# ============================================================
# IMAP test client credentials
#
# These are the Bridge-generated credentials, NOT your Proton password.
# Retrieve them after logging in:
#   docker compose stop proton-bridge
#   docker compose run --rm -it proton-bridge --cli
#   > info
#   docker compose up -d
# ============================================================

# Service name on the Docker bridge-net network (not 127.0.0.1 — that is the
# host loopback and is not reachable from inside a container).
BRIDGE_IMAP_HOST=proton-bridge

# socat proxy port inside the proton-bridge container.
# Bridge binds to 127.0.0.1:1143; socat re-exposes it on 0.0.0.0:2143
# so other containers on bridge-net can reach it.
BRIDGE_IMAP_PORT=2143

BRIDGE_IMAP_USER=your.address@proton.me
BRIDGE_IMAP_PASS=                          # paste Bridge-generated password here

# Optional: filter INBOX by recipient (To or Cc). Leave empty to show all.
# Useful for multi-address mailboxes — set to the specific address you want.
BRIDGE_FILTER_TO=

# Max messages to display. 0 = no limit (show all matched messages).
BRIDGE_FETCH_LIMIT=0

# Bridge uses STARTTLS on port 1143/2143 (not SSL).
# The self-signed cert is for 127.0.0.1; skip hostname verification.
BRIDGE_IMAP_SSL=false
BRIDGE_SKIP_TLS_VERIFY=true
