# ============================================================
# Proton Mail Bridge — local Docker configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Bridge image version to build.
# Check latest: https://github.com/ProtonMail/proton-bridge/releases
BRIDGE_VERSION=3.24.2

# ============================================================
# IMAP test client credentials
#
# These are the Bridge-generated credentials, NOT your Proton password.
# Retrieve them after logging in:
#   docker compose stop proton-bridge
#   docker compose run --rm -it proton-bridge --cli
#   > info
#   docker compose up -d
# ============================================================

# Service name on the Docker bridge-net network (not 127.0.0.1 — that is the
# host loopback and is not reachable from inside a container).
BRIDGE_IMAP_HOST=proton-bridge

# socat proxy port inside the proton-bridge container.
# Bridge binds to 127.0.0.1:1143; socat re-exposes it on 0.0.0.0:2143
# so other containers on bridge-net can reach it.
BRIDGE_IMAP_PORT=2143

BRIDGE_IMAP_USER=your.address@proton.me
BRIDGE_IMAP_PASS=                          # paste Bridge-generated password here

# Optional: filter INBOX by recipient (To or Cc). Leave empty to show all.
# Comma-separate multiple addresses to match any of them.
# BRIDGE_FILTER_TO=info@biopentra.eu
# BRIDGE_FILTER_TO=info@biopentra.eu,support@biopentra.eu
BRIDGE_FILTER_TO=

# Max messages to display. 0 = no limit (show all matched messages).
BRIDGE_FETCH_LIMIT=0

# Bridge uses STARTTLS on port 1143/2143 (not SSL).
# The self-signed cert is for 127.0.0.1; skip hostname verification.
BRIDGE_IMAP_SSL=false
BRIDGE_SKIP_TLS_VERIFY=true

# ============================================================
# Mail worker (docker compose --profile worker up -d)
#
# The worker polls Proton Bridge IMAP and POSTs each message
# to a generic REST API (e.g. biopentra-support/v1).
# ============================================================

# IMAP connection — same Bridge credentials as the test client above
IMAP_HOST=proton-bridge
IMAP_PORT=2143
IMAP_USER=your.address@proton.me
IMAP_PASS=                          # paste Bridge-generated password here

# Mailbox to poll.
IMAP_MAILBOX=INBOX

# How the worker tracks which messages it has already imported:
#
#   keyword  (default) — set a custom IMAP keyword after import.
#              Search:  UNKEYWORD <IMAP_FETCH_KEYWORD>
#              Mark:    +FLAGS (FETCHED)
#              Proton Bridge may not support custom keywords — test first.
#              If it fails, switch to flagged.
#
#   flagged  — use the standard \Flagged flag (the "starred" marker in Proton).
#              Search:  UNFLAGGED
#              Mark:    +FLAGS (\Flagged)
#              Always works; but occupies the star/pin flag.
#
#   seen     — use the standard \Seen flag.
#              Search:  UNSEEN
#              Mark:    +FLAGS (\Seen)
#              Risk: Proton mobile app also sets \Seen when you open a message.
#
#   none     — fetch ALL messages every cycle; rely on imap_dedupe_key in the
#              API to skip duplicates. Stateless but heavier.
#              Search:  ALL
#              Mark:    nothing
#
IMAP_FETCH_MODE=keyword

# Custom IMAP keyword name (only used when IMAP_FETCH_MODE=keyword).
IMAP_FETCH_KEYWORD=FETCHED

# Override the auto-derived IMAP search expression.
# Leave empty to let IMAP_FETCH_MODE determine it automatically.
IMAP_SEARCH=

# REST API base URL — no trailing slash
API_BASE_URL=https://your-site.example.com/wp-json/biopentra-support/v1

# Bearer token for the REST API.
# Store only the hashed value server-side; paste the raw token here.
API_TOKEN=

# Seconds between poll cycles.
POLL_INTERVAL=300

# Max messages to import per cycle. 0 = no limit.
MESSAGE_CAP=50

# Reported in the worker heartbeat payload.
WORKER_VERSION=1.0.0

# Port for the internal HTTP trigger server (GET /health, POST /poll).
# Accessible only from containers on the same Docker network — never published.
WORKER_HTTP_PORT=8080
